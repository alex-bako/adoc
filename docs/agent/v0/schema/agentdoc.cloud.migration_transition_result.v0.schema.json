{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_transition_result.v0.schema.json",
  "title": "agentdoc.cloud.migration_transition_result.v0",
  "description": "Closed native transport returning only exact stored receipt bytes and their SHA256 digest. The worker verifies the digest and native bindings; there is no parsed authoritative duplicate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_bytes_base64",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_transition_result.v0"
    },
    "receipt_bytes_base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
