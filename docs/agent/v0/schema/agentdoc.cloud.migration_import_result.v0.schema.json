{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_import_result.v0.schema.json",
  "title": "AgentDoc Cloud Migration Import Result",
  "description": "Cloud native import RPC response mapping the exact request to immutable inactive candidate versions. Transport response only; does not confer qualification, activation or promotion authority.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_import_result.v0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "canonical_id",
          "version_id",
          "source_record_id",
          "source_binding_id"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "canonical_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "source_binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          }
        }
      }
    }
  }
}
