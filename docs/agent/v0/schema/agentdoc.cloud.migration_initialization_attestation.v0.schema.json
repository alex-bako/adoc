{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_initialization_attestation.v0.schema.json",
  "title": "AgentDoc Cloud Migration Initialization Attestation",
  "description": "Cloud-owned immutable attestation binding exact command, qualification, human identity/session and authorization evidence. Native canonical JSON plus newline defines retained attestation bytes and digest. Acceptance of revision/history as initialization evidence is not a verification or truth assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_digest",
    "workspace_id",
    "qualification_id",
    "migration_request_digest",
    "qualification_envelope_digest",
    "qualification_receipt_digest",
    "qualification_policy_version",
    "lifecycle_mapping_version",
    "initialization_policy_version",
    "principal_id",
    "identity_session_id",
    "auth_session_id",
    "external_identity_link_id",
    "authorization_decision_id",
    "authorization_decision_digest",
    "authorization_policy_version",
    "attested_at",
    "meaning",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_initialization_attestation.v0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "migration_request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "qualification_envelope_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "qualification_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "qualification_policy_version": {
      "const": "1"
    },
    "lifecycle_mapping_version": {
      "const": "1"
    },
    "initialization_policy_version": {
      "const": "migration-initialization-v1"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identity_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "auth_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "external_identity_link_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authorization_decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authorization_decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorization_policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S",
      "description": "Native authorization decision policy version, additionally bounded to 1024 UTF-8 bytes; distinct from qualification and initialization policies."
    },
    "attested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "meaning": {
      "const": "accept_exact_revision_and_qualifying_history_as_initialization_evidence"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S",
      "description": "Human rationale. Native admission additionally limits the exact UTF-8 encoding to 4096 bytes."
    }
  }
}
