{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_qualification_result.v0.schema.json",
  "title": "AgentDoc Cloud Migration Qualification Result",
  "description": "Cloud-owned native admission response only. Source entries sorted by portable path carry INTERNAL database UUIDs, distinct from producer job IDs. Candidates retain T2 mapping and are empty for flagged evidence. No lifecycle authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "qualification_id",
    "outcome",
    "candidates",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_qualification_result.v0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "qualification_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "outcome": {
      "enum": [
        "evaluated",
        "flagged_source_evidence"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "canonical_id",
          "version_id",
          "source_record_id",
          "source_binding_id"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "canonical_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          },
          "source_binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "source_record_id",
          "source_binding_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000-\\u001f]+$"
          },
          "source_record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "source_binding_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    }
  }
}
